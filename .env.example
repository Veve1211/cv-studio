# Claude API key (required for generating CVs)
ANTHROPIC_API_KEY=
# Stripe secret key, test mode (optional; without it PDF export is free)
STRIPE_SECRET_KEY=
# Public URL used for Stripe return links, e.g. https://cvecko.up.railway.app (optional)
APP_URL=
# Optional: secret for the internal print page (defaults to a value derived from STRIPE_SECRET_KEY)
PDF_RENDER_SECRET=
# Local/CI only: path to a Chromium binary for the server-side PDF (Railway uses @sparticuz/chromium)
CHROMIUM_PATH=
# Optional cookie-less analytics: Plausible or Umami script URL + site id
ANALYTICS_URL=
ANALYTICS_ID=
# Optional: secret for the restart-proof rate-limit cookie (defaults to another server secret)
RATE_LIMIT_SECRET=
# Optional: presentation mode – with 1, opening the site with ?demo=1 unlocks everything in that browser for 3 hours
DEMO_ENABLED=
# Optional (with Stripe): secret that signs paid access cookies and access codes
ACCESS_SECRET=
# Optional (with Stripe): prices in CZK for 14 days and one year (defaults 99 and 299)
PRICE_14D_CZK=
PRICE_YEAR_CZK=
# Optional: Ko-fi page (https) for the "Kup mi kafe" link; without it nothing is shown
KOFI_URL=
