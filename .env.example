# Claude API key (required for generating CVs)
ANTHROPIC_API_KEY=
# Stripe secret key, test mode (optional; without it PDF export is free)
STRIPE_SECRET_KEY=
# Public URL used for Stripe return links, e.g. https://cvecko.up.railway.app (optional)
APP_URL=
# Optional: secret for the internal print page (defaults to a value derived from STRIPE_SECRET_KEY)
PDF_RENDER_SECRET=
# Local/CI only: path to a Chromium binary for the server-side PDF (Railway uses @sparticuz/chromium)
CHROMIUM_PATH=
# Optional cookie-less analytics (read at build time): Plausible or Umami script URL + site id
ANALYTICS_URL=
ANALYTICS_ID=
